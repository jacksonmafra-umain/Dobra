{
  "name": "@dobra/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force && node scripts/copy-tools.mjs",
    "preview": "astro preview",
