    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@dobra/brand": "*",
    "@dobra/core": "*",
    "astro": "^7.3.5",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
