{
  "$comment": "Sample app profile: components, pane scenes, typography, the app manifest, layout rules, tab bar and screens for the neutral sample app.",
  "components": {
    "$comment": "Every component the rules can lay out. kind says which rule settings it takes; gap is the space between items; minLegibleWidth is the narrowest box its text still reads in (checked by the width-loss check).",
    "news_story_hero": {
      "kind": "hero",
      "split": {
        "imageFraction": 0.5,
        "textPadding": 48
      },
      "minLegibleWidth": 200,
      "source": "figma-ui"
    },
    "action_card": {
      "kind": "grid",
      "gap": 12,
      "minLegibleWidth": 240,
      "source": "figma-ui"
    },
    "shortcut_card_item": {
      "kind": "grid",
      "gap": 12,
      "minLegibleWidth": 82,
      "source": "figma-ui",
      "forms": [
        "perRow",
        "flex"
      ],
      "items": 3
    },
    "news_story_card": {
      "kind": "grid",
      "gap": 24,
      "minLegibleWidth": 200,
      "source": "figma-ui"
    },
    "reward_card": {
      "kind": "grid",
      "gap": 16,
      "minLegibleWidth": 120,
      "source": "figma-ui"
    },
    "deal_card": {
      "kind": "grid",
      "gap": 24,
      "minLegibleWidth": 200,
      "source": "figma-ui"
    },
    "bonus_campaign_banner": {
      "kind": "grid",
      "gap": 12,
      "minLegibleWidth": 240,
      "source": "figma-ui"
    },
    "product_card": {
      "kind": "grid",
      "gap": 16,
      "minLegibleWidth": 150,
      "forms": [
        "perRow",
        "grid"
      ],
      "items": 8,
      "source": "estimated"
    },
    "restaurant-card-small": {
      "kind": "carousel"
    },
    "tab_bar_26": {
      "kind": "tab-bar"
    }
  },
  "scenes": {
    "$comment": "Pane strategies named after Navigation 3 SceneStrategy. A screen declares one; the engine splits at a separating hinge, splits by the parameters when both minimum widths fit, and otherwise falls back to one pane.",
    "list-detail": {
      "strategy": "list-detail",
      "listFraction": 0.4,
      "listMinWidth": 320,
      "detailMinWidth": 360,
      "textMinWidth": 240,
      "source": "material3"
    },
    "two-pane": {
      "strategy": "two-pane",
      "ratio": 0.5,
      "paneMinWidth": 320,
      "source": "material3"
    },
    "supporting-pane": {
      "strategy": "supporting-pane",
      "supportingWidth": 360,
      "mainMinWidth": 400,
      "source": "material3"
    }
  },
  "typography": {
    "$comment": "Sample design system type styles (figma-tokens). pt on iOS, sp on Android.",
    "H0": {
      "size": 56,
      "lineHeight": 62
    },
    "H1": {
      "size": 32,
      "lineHeight": 35
    },
    "H2": {
      "size": 24,
      "lineHeight": 26
    },
    "H3": {
      "size": 17,
      "lineHeight": 19
    },
    "H4": {
      "size": 14,
      "lineHeight": 16
    },
    "Paragraph-Medium": {
      "size": 14,
      "lineHeight": 18
    },
    "Paragraph-Small": {
      "size": 12,
      "lineHeight": 15
    },
    "Paragraph-XSmall": {
      "size": 10,
      "lineHeight": 16
    },
    "Button": {
      "size": 16,
      "lineHeight": 19
    },
    "Badge": {
      "size": 12,
      "lineHeight": 16
    },
    "TabBar": {
      "size": 11,
      "lineHeight": 14
    }
  },
  "app": {
    "android": {
      "targetSdk": 36,
      "screenOrientation": "unspecified",
      "configChanges": [
        "orientation",
        "screenSize",
        "screenLayout",
        "smallestScreenSize",
        "keyboardHidden"
      ],
      "source": "estimated",
      "$note": "Assumed Android manifest values. density and fontScale are not listed, so those changes recreate the activity."
    }
  },
  "layoutRules": [
    {
      "id": "phone-portrait",
      "label": "Compact width · Regular height",
      "platform": "ios",
      "match": {
        "horizontal": "compact",
        "vertical": "regular"
      },
      "pageMargin": {
        "base": 24,
        "mode": "max",
        "$comment": "max = max(base, safe area). Reproduces hSafeAreaInset: 24 portrait."
      },
      "grid": {
        "columns": 4,
        "gutter": 16,
        "proposed": true
      },
      "panes": 1,
      "components": {
        "news_story_hero": {
          "variant": "stacked",
          "bleed": "full"
        },
        "action_card": {
          "perRow": 1
        },
        "shortcut_card_item": {
          "perRow": 3
        },
        "restaurant-card-small": {
          "mode": "carousel"
        },
        "tab_bar_26": {
          "item": "stacked",
          "$comment": "stacked = icon over label; inline = label beside icon (Figma landscape variant)"
        },
        "reward_card": {
          "perRow": 2,
          "minItemWidth": 128,
          "maxItemWidth": 190
        },
        "deal_card": {
          "perRow": 1,
          "minItemWidth": 320,
          "maxItemWidth": 375
        },
        "bonus_campaign_banner": {
          "perRow": 1,
          "minItemWidth": 272
        },
        "news_story_card": {
