{
  "name": "dobra",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dobra/simulator --",
    "build": "npm run build -w @dobra/simulator",
    "build:single": "npm run build:single -w @dobra/simulator",
    "preview": "npm run preview -w @dobra/simulator --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:report": "npm run dev -w @dobra/report --",
    "build:report": "npm run build -w @dobra/report",
    "hinge": "node packages/cli/dist/hinge.mjs",
    "build:cli": "npm run build -w @dobra/cli"
  }
}
