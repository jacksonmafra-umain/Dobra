{
  "name": "dobra",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dobra/simulator --",
    "build": "npm run build -w @dobra/simulator",
    "build:single": "npm run build:single -w @dobra/simulator",
    "preview": "npm run preview -w @dobra/simulator --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:report": "npm run dev -w @dobra/report --",
    "build:report": "npm run build -w @dobra/report",
    "dobra": "node packages/cli/dist/dobra.mjs",
    "build:cli": "npm run build -w @dobra/cli",
    "dev:site": "npm run dev -w @dobra/site --",
    "build:site": "npm run build -w @dobra/simulator && npm run build -w @dobra/report && npm run build -w @dobra/site"
  }
}
